# Sao chép thành .env (KHÔNG commit). Không đặt giá trị thật vào file này.

# --- PostgreSQL ---
POSTGRES_PASSWORD=
DATABASE_URL=postgres://submaker:CHANGE_ME@127.0.0.1:5439/submaker

# --- MinIO (S3) ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=http://127.0.0.1:59000
S3_REGION=us-east-1
S3_BUCKET=submaker
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Bảo mật ---
# 32 byte ngẫu nhiên, mã hóa base64 (ví dụ: openssl rand -base64 32). Dùng để mã hóa khóa API nhà cung cấp.
APP_ENCRYPTION_KEY=
# Chuỗi ngẫu nhiên dài (ví dụ: openssl rand -base64 48). Dùng cho phiên đăng nhập.
AUTH_SECRET=
# Địa chỉ công khai của ứng dụng (dùng kiểm tra Origin)
APP_URL=http://localhost:3000

# --- Administrator cấp sẵn (tạo/đồng bộ lúc khởi động) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Giới hạn tốc độ xác thực (mặc định an toàn, hiếm khi cần đổi) ---
# RATE_LIMIT_SIGNIN_PER_MIN=5
# RATE_LIMIT_SIGNUP_PER_HOUR=5

# --- Cloudflare Tunnel (chỉ production) ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Nhà cung cấp AI ---
# Chỉ đặt true khi dev/kiểm thử với máy chủ giả dùng http. Production PHẢI là false.
ALLOW_INSECURE_PROVIDER_URLS=false
# CHỈ dùng cho kiểm thử E2E (cho phép ALLOW_INSECURE_PROVIDER_URLS trên bản build production). Không đặt ở môi trường thật.
# E2E_MODE=1

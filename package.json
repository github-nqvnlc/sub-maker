{
  "name": "sub-maker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker:dev": "tsx watch --env-file-if-exists=.env src/worker/index.ts",
    "worker:start": "tsx --env-file-if-exists=.env src/worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/lib/db/migrate.ts",
    "test": "vitest run --project unit --project integration --project contract",
    "test:unit": "vitest run --project unit",
    "test:e2e": "playwright test",
    "test:isolation": "vitest run --project isolation",
    "lint": "eslint .",
    "check:i18n": "tsx scripts/check-i18n.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1172.0",
    "@napi-rs/canvas": "^1.2.0",
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-virtual": "^3.14.26",
    "better-auth": "^1.7.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "latest",
    "mdast-util-to-string": "^4.0.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shadcn": "^4.23.0",
    "sonner": "latest",
    "tailwind-merge": "^3.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.6",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.0.0",
    "tw-animate-css": "latest",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1",
    "yaml": "^2.0.0"
  }
